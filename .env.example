# Copy to .env locally, or use scripts/run.ps1 -Mode Live -EnvFile <existing-config>.
# Never commit real keys. The runner does not print values or execute .env contents.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_TEXT_MODEL=doubao-seed-2-1-turbo-260628
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
ARK_IMAGE_SIZE=2K
ARK_VIDEO_MODEL=doubao-seedance-2-0-fast-260128
ARK_VIDEO_RESOLUTION=480p
ARK_VIDEO_MIN_DURATION=4
ARK_VIDEO_MAX_DURATION=15
ARK_VIDEO_DURATION_STEP=1
ARK_VIDEO_SUPPORTED_DURATIONS=4,8,12
ARK_TEXT_API_STYLE=responses
SEED_AUDIO_API_KEY=
SEED_AUDIO_MODEL=seed-audio-1.0
SEED_AUDIO_URL=https://openspeech.bytedance.com/api/v3/tts/create
SEED_AUDIO_SPEAKER=
ARK_ASSET_ACCESS_KEY_ID=
ARK_ASSET_SECRET_ACCESS_KEY=
ARK_ASSET_REGION=cn-beijing
DATABASE_URL=jdbc:postgresql://localhost:5432/drama
DATABASE_USER=drama
DATABASE_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
STORAGE_MODE=local
STORAGE_ROOT=./data/media
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Only active when DRAMA_TEST_RUN=true. Local Mock/Media modes do not consume these limits.
TEST_MAX_COST_CNY=5
TEST_MAX_REAL_LLM_REQUESTS=20
TEST_MAX_REAL_IMAGE_REQUESTS=2
TEST_MAX_REAL_VIDEO_REQUESTS=2
TEST_MAX_REAL_AUDIO_REQUESTS=5
TEST_MAX_REAL_LIPSYNC_REQUESTS=2

# Provider video capabilities are adapter-owned allowlists (see ProviderCapabilityRegistry).
# They are not accepted from page input. CONTINUOUS shots use reference_video when supported,
# otherwise an approved previous last frame; first_frame and reference_video are mutually exclusive.

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.shiguang.invalid/schemas/26-timeline-planning-output.json",
  "title": "26-timeline-planning-output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "projectVersion": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object",
      "properties": {
        "timeline": {},
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "track": {
                "enum": ["VIDEO", "DIALOGUE", "AMBIENCE", "SFX", "BGM"]
              },
              "startMs": {"type": "integer", "minimum": 0},
              "durationMs": {"type": "integer", "minimum": 1},
              "sourceInMs": {"type": "integer", "minimum": 0},
              "sourceOutMs": {"type": "integer", "minimum": 1},
              "pauseDurationMs": {"type": "integer", "minimum": 1},
              "gapBeforeMs": {"type": "integer", "minimum": 1},
              "editOperations": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": ["TRIM", "CUT", "REACTION_SHOT", "INSERT_SHOT", "J_CUT", "L_CUT", "AUDIO_BRIDGE", "DIALOGUE_GAP", "PAUSE", "CLIP_REPLACE"]
                }
              }
            },
            "required": ["track", "startMs", "durationMs", "editOperations"]
          }
        }
      },
      "required": [
        "timeline",
        "items"
      ],
      "additionalProperties": true
    },
    "trace": {
      "type": "object",
      "additionalProperties": true
    },
    "status": {
      "enum": [
        "READY",
        "HUMAN_REVIEW_REQUIRED",
        "FAILED"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "projectId",
    "projectVersion",
    "payload",
    "status",
    "warnings"
  ]
}
